<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plus"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATION"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp" />

            <!-- Ligne 1 : Carte & Sorties + Documents -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Carte & Sorties -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_map"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="130dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <!-- CORRECTION : ImageView au lieu de View -->
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_map"
                            android:src="@drawable/ic_map"
                            android:padding="12dp"
                            android:layout_marginBottom="10dp"
                            android:contentDescription="Carte" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carte &amp; Sorties"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:maxLines="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="École et sorties scolaires"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:maxLines="2" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Documents -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_documents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="130dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <!-- CORRECTION : ImageView au lieu de View -->
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_document"
                            android:src="@drawable/ic_document"
                            android:padding="12dp"
                            android:layout_marginBottom="10dp"
                            android:contentDescription="Documents" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Documents"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:maxLines="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bulletins et certificats"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:maxLines="2" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Ligne 2 : Profil élève + Paramètres -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Profil élève -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_profile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="130dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <!-- CORRECTION : ImageView au lieu de View -->
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_profile"
                            android:src="@drawable/ic_profile"
                            android:padding="12dp"
                            android:layout_marginBottom="10dp"
                            android:contentDescription="Profil élève" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profil élève"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:maxLines="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Infos &amp; statistiques"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:maxLines="2" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Paramètres -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="130dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <!-- CORRECTION : ImageView au lieu de View -->
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icon_settings"
                            android:src="@drawable/ic_settings"
                            android:padding="12dp"
                            android:layout_marginBottom="10dp"
                            android:contentDescription="Paramètres" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paramètres"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:maxLines="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notifications &amp; thème"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:maxLines="2" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Messages — carte pleine largeur -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_messages"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="80dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <!-- CORRECTION : ImageView + bon drawable bg_icon_messages -->
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_messages"
                        android:src="@drawable/ic_message"
                        android:padding="10dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="Messages" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Messages"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enseignants &amp; administration"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>