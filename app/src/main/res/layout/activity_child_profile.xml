<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Hero Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_home_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- CORRECTION : Avatar avec fond circulaire blanc semi-transparent -->
        <TextView
            android:id="@+id/tv_initial"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="@font/poppins_bold"
            android:background="@drawable/bg_icon_profile"
            app:layout_constraintTop_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emma Martin"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_initial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_student_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N° 20240001"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Stats strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="2dp">

        <!-- Classe -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="3ème A"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Classe"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="36dp"
            android:background="@color/divider" />

        <!-- Moyenne -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tv_average" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/success" android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Moyenne" android:textColor="@color/text_tertiary"
                android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="36dp"
            android:background="@color/divider" />

        <!-- Absences -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tv_absences" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="@color/danger" android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Absences" android:textColor="@color/text_tertiary"
                android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="36dp"
            android:background="@color/divider" />

        <!-- Retards -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tv_late" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="@color/warning" android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Retards" android:textColor="@color/text_tertiary"
                android:textSize="11sp" android:fontFamily="@font/poppins_regular" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- School info card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="18dp" app:cardElevation="0dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ÉTABLISSEMENT" android:textColor="@color/text_tertiary"
                        android:textSize="11sp" android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.08" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_school" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Lycée Victor Hugo"
                        android:textColor="@color/text_primary" android:textSize="15sp"
                        android:fontFamily="@font/poppins_semibold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CORRECTION : Boutons actions rapides sans style custom -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">

                <!-- Bouton Carte -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_map"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Carte"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textAllCaps="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:icon="@drawable/ic_directions"
                    app:iconTint="@color/primary"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@android:color/transparent" />

                <!-- Bouton Docs -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_documents"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Docs"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textAllCaps="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:icon="@drawable/ic_document"
                    app:iconTint="@color/primary"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    app:backgroundTint="@android:color/transparent" />

                <!-- Bouton Message -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_messages"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Message"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textAllCaps="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:icon="@drawable/ic_message"
                    app:iconTint="@color/white"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/primary" />

            </LinearLayout>

            <!-- Dernières notes -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Dernières notes"
                android:textColor="@color/text_primary" android:textSize="17sp"
                android:fontFamily="@font/poppins_semibold" android:layout_marginBottom="12dp" />

            <ProgressBar android:id="@+id/pb_loading"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center" android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_grades"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>