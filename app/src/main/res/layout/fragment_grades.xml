<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Tout le contenu principal dans un LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="16dp"
            android:orientation="vertical">

            <!-- Titre + Moyenne -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notes"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_avg_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tv_average_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tv_average_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moyenne"
                        android:textColor="#AAFFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chips trimestre sur fond distinct -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_trimester"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Tous"
                            android:tag="all"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_selector_grades"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_text_grades"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_t1"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Trimestre 1"
                            android:tag="T1"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_selector_grades"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_text_grades"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_t2"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Trimestre 2"
                            android:tag="T2"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_selector_grades"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_text_grades"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_t3"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Trimestre 3"
                            android:tag="T3"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/chip_selector_grades"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_text_grades"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="13sp" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune note pour ce trimestre"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:layout_marginTop="64dp"
            android:visibility="gone" />

        <!-- RecyclerView à la fin avec padding en bas pour le FAB -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_grades"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="96dp" /> <!-- Important : hauteur FAB + marge (56+40) -->
    </LinearLayout>

    <!-- Le FAB est "hors" LinearLayout et superposé OWN ! -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scan"
        style="@style/Widget.SchoolApp.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_camera"
        android:contentDescription="Scanner bulletin" />

</FrameLayout>